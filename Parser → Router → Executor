import bus from "./EventBus";

import {
  executeTools
} from "./executor";


class ExecutorAgent {

  constructor() {

    this.name =
      "Executor Agent";

    this.status =
      "online";
  }


  // =====================
  // EXECUTE
  // =====================
  async execute(
    tools = []
  ) {

    bus.emit(
      "executor:start",
      {
        agent: this.name,
        tools
      }
    );


    const results =
      await executeTools(
        tools
      );


    bus.emit(
      "executor:finished",
      {
        agent: this.name,
        results
      }
    );


    return results;
  }


  // =====================
  // STATUS
  // =====================
  getStatus() {

    return {
      name: this.name,
      status: this.status
    };
  }

}


const executorAgent =
  new ExecutorAgent();


export default
  executorAgent;
